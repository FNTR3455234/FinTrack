meta {
  name: 400 con un id mal escrito
  type: http
  seq: 4
}

get {
  url: {{base_url}}/api/v1/cuentas/no-es-un-objectid
  body: none
  auth: inherit
}

tests {
  test("responde 400", function () {
      expect(res.getStatus()).to.equal(400);
  });
  test("el codigo es ID_INVALIDO", function () {
      expect(res.getBody().error.codigo).to.eql("ID_INVALIDO");
  });
}

docs {
  El identificador tiene que ser hexadecimal de 24 caracteres.
}

