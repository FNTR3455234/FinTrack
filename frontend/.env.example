# Copia este archivo como frontend/.env si necesitas cambiar algo.
# Sin .env, todo funciona con los valores de desarrollo por defecto.

# A donde apunta el proxy de Vite en desarrollo.
VITE_API_URL=http://localhost:8080

# Ruta base de la API. Se deja relativa a proposito: en desarrollo la resuelve
# el proxy de Vite y en produccion la sirve el mismo servidor que el bundle,
# asi que no hay que recompilar para cambiar de entorno.
VITE_API_BASE=/api/v1
