# Variables del stack completo (docker-compose.yml).
#
#   cp .env.example .env     y cambia los secretos
#   make env                 genera un .env con secretos aleatorios
#
# El .env real esta en .gitignore. Este archivo de ejemplo si se versiona: es la
# lista de lo que hay que configurar.
#
# OJO: no es el mismo archivo que backend/.env, que es para correr la API en
# local sin contenedores.

# --- Base de datos ---
MONGO_USUARIO=fintrack_admin
MONGO_PASSWORD=cambia_esta_password
MONGO_BD=fintrack

# --- JWT ---
# Minimo 32 caracteres cada uno y distintos entre si: la configuracion lo
# valida al arrancar y el servidor no levanta si no se cumple.
#
# Ademas, con GIN_MODO=release (que es lo que pone el compose) un secreto que
# empiece por "cambia_este" tambien lo rechaza. Es a proposito: el stack no
# arranca con los valores de ejemplo.
JWT_SECRETO_ACCESO=cambia_este_secreto_de_acceso_por_uno_aleatorio
JWT_SECRETO_REFRESCO=cambia_este_secreto_de_refresco_por_uno_aleatorio
JWT_MINUTOS_ACCESO=15
JWT_DIAS_REFRESCO=7

# --- Red ---
# Puerto en tu maquina. La aplicacion queda en http://localhost:<PUERTO_WEB>
PUERTO_WEB=8080
CORS_ORIGENES=http://localhost:8080

# --- Version ---
# Se graba en el binario con -ldflags y etiqueta las imagenes. La responde
# /api/v1/health, asi que sirve para saber que hay desplegado.
VERSION=1.0.0
