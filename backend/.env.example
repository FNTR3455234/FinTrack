# Copia este archivo como backend/.env y ajusta los valores.
# El .env real esta en .gitignore y nunca se sube al repositorio.

# --- Servidor HTTP ---
PUERTO=8080
# release para produccion, debug para desarrollo
GIN_MODO=debug

# --- MongoDB ---
# Coincide con las credenciales de docker-compose.dev.yml.
# authSource=admin porque el usuario root vive en la base admin.
MONGO_URI=mongodb://fintrack_admin:fintrack_dev_2026@localhost:27017/?authSource=admin
MONGO_BD=fintrack

# --- JWT ---
# Cambia estos secretos por cadenas largas y aleatorias antes de desplegar.
JWT_SECRETO_ACCESO=cambia_este_secreto_de_acceso_en_produccion
JWT_SECRETO_REFRESCO=cambia_este_secreto_de_refresco_en_produccion
JWT_MINUTOS_ACCESO=15
JWT_DIAS_REFRESCO=7

# --- CORS ---
# Origenes permitidos separados por coma (el frontend de Vite corre en el 5173).
CORS_ORIGENES=http://localhost:5173
